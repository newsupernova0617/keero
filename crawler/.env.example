# 데이터베이스 경로
DB_PATH=../data/app.db
LOGS_DB_PATH=../data/logs.db
LOGS_RETENTION_DAYS=30

# Cloudflare R2 설정
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=humor-posts

# ⚠️ 중요: R2 공개 URL 설정
# Cloudflare 대시보드에서 R2 버킷의 "Public Access" 설정 후 아래 URL을 입력하세요
# 옵션 1: R2 Public Bucket URL (예: https://pub-xxxxxxxxxxxxx.r2.dev)
# 옵션 2: Custom Domain (예: https://cdn.yourdomain.com)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxx.r2.dev
